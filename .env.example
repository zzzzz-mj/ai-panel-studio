# ============================================================
# AI Panel Studio —— 后端环境变量模板
# 复制为 .env 后填写。注意：本文件只被后端进程读取，
# 大模型 API Key 绝不会出现在任何前端产物或浏览器请求中。
# ============================================================

# ---- 服务 ----
PORT=8787
# SQLite 数据库文件位置（相对 server/ 目录）
DB_PATH=./data/panel.db
# 允许跨域的前端地址（本地开发默认 Vite 端口）
CORS_ORIGIN=http://localhost:5173

# ---- 大模型（OpenAI 兼容协议）----
# 可选值：deepseek | openai | custom
LLM_PROVIDER=deepseek
# 密钥只放在这里，禁止硬编码进代码或提交到仓库
LLM_API_KEY=
# DeepSeek 官方：https://api.deepseek.com/v1
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 采样温度：圆桌讨论需要观点发散，略高于常规问答
LLM_TEMPERATURE=0.9
# 单次请求超时（毫秒）
LLM_TIMEOUT_MS=60000

# ---- 模拟引擎 ----
# true 时完全离线运行：不调用任何外部 API，用确定性规则引擎驱动讨论。
# 未配置 LLM_API_KEY 时自动降级为 true，保证零配置可演示、可测试。
LLM_MOCK=false

# ---- 讨论引擎节拍 ----
# 每个发言之间的停顿（毫秒），用于营造"实时讨论"的节奏感
TURN_INTERVAL_MS=900
# 每场讨论的最大发言轮次（防止无限循环烧 token）
MAX_TURNS=24
