{
  "name": "ai-panel-studio",
  "version": "1.0.0",
  "private": true,
  "description": "AI Panel Studio —— AI 圆桌讨论本地 Web 应用（MVP）",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm --workspace server run dev",
    "dev:web": "npm --workspace web run dev",
    "build": "npm --workspace server run build && npm --workspace web run build",
    "start": "npm --workspace server run start",
    "test": "npm --workspace server run test",
    "db:seed": "npm --workspace server run db:seed",
    "db:reset": "npm --workspace server run db:reset"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
